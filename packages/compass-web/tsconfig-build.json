{
  "extends": "@mongodb-js/tsconfig-compass/tsconfig.build.json",
  "compilerOptions": {
    // reversing options that are not relevant for the build
    "allowImportingTsExtensions": false,
    "rewriteRelativeImportExtensions": true,
    "noEmit": false
  },
  "include": ["src/**/*"],
  "exclude": ["./src/**/*.spec.*"]
}
