{
  "$schema": "https://developer.microsoft.com/json-schemas/api-extractor/v7/api-extractor.schema.json",
  "mainEntryPointFilePath": "./dist/index.d.ts",
  "newlineKind": "lf",
  "bundledPackages": [
    "@mongodb-js/*",
    "@mongodb-js/mdb-experiment-js",
    "@mongodb-js/connection-info",
    "@mongodb-js/bson-transpilers",
    "compass-e2e-tests",
    "@mongodb-js/compass-preferences-model",
    "@mongodb-js/hadron-build",
    "@mongodb-js/hadron-document",
    "@mongodb-js/hadron-ipc",
    "@mongodb-js/hadron-type-checker",
    "@mongodb-js/mongodb-instance-model",
    "mongodb-explain-compat",
    "@mongodb-js/mongodb-query-util",
    "@mongodb-js/mongodb-data-service",
    "@mongodb-js/mongodb-database-model",
    "@mongodb-js/mongodb-collection-model",
    "mongodb-compass"
  ],
  "compiler": {
    "tsconfigFilePath": "./tsconfig-build.json"
  },
  "dtsRollup": {
    "enabled": true,
    "publicTrimmedFilePath": "./dist/<unscopedPackageName>.d.ts"
  },
  "apiReport": {
    "enabled": false
  },
  "docModel": {
    "enabled": false
  }
}
