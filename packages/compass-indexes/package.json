{
  "name": "@mongodb-js/compass-indexes",
  "description": "Collection index management for Compass",
  "author": {
    "name": "MongoDB Inc",
    "email": "compass@mongodb.com"
  },
  "private": true,
  "version": "6.4.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/mongodb-js/compass.git"
  },
  "license": "SSPL",
  "homepage": "https://github.com/mongodb-js/compass",
  "bugs": {
    "url": "https://jira.mongodb.org/projects/COMPASS/issues",
    "email": "compass@mongodb.com"
  },
  "files": [
    "dist"
  ],
  "main": "dist/index.js",
  "compass:main": "src/index.ts",
  "types": "dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js"
  },
  "compass:exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "bootstrap": "npm run compile",
    "compile": "tsc -p tsconfig-build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "eslint": "eslint-compass",
    "prettier": "prettier-compass",
    "lint": "npm run eslint . && npm run prettier -- --check .",
    "depcheck": "compass-scripts check-peer-deps && depcheck",
    "check": "npm run typecheck && npm run lint && npm run depcheck",
    "check-ci": "npm run check",
    "test": "mocha",
    "test-electron": "xvfb-maybe electron-mocha --no-sandbox",
    "test-cov": "nyc --compact=false --produce-source-map=false -x \"**/*.spec.*\" --reporter=lcov --reporter=text --reporter=html npm run test",
    "test-watch": "npm run test -- --watch",
    "test-ci": "npm run test-cov",
    "test-ci-electron": "npm run test-electron",
    "reformat": "npm run eslint . -- --fix && npm run prettier -- --write ."
  },
  "devDependencies": {
    "@mongodb-js/eslint-config-compass": "^1.4.27",
    "@mongodb-js/mocha-config-compass": "^1.8.1",
    "@mongodb-js/prettier-config-compass": "^1.2.9",
    "@mongodb-js/testing-library-compass": "^1.7.1",
    "@mongodb-js/tsconfig-compass": "^1.3.1",
    "chai": "^4.2.0",
    "depcheck": "^1.4.1",
    "electron": "^44.4.5",
    "electron-mocha": "^12.2.0",
    "mocha": "^10.2.0",
    "nyc": "^15.1.0",
    "react-dom": "^18.3.1",
    "sinon": "^9.2.3",
    "typescript": "^6.0.3",
    "xvfb-maybe": "^0.2.1"
  },
  "dependencies": {
    "@mongodb-js/atlas-service": "^1.4.0",
    "@mongodb-js/compass-app-registry": "^9.15.0",
    "@mongodb-js/compass-app-stores": "^8.4.0",
    "@mongodb-js/compass-components": "^1.70.0",
    "@mongodb-js/compass-connections": "^2.4.0",
    "@mongodb-js/compass-editor": "^0.72.0",
    "@mongodb-js/compass-field-store": "^10.4.0",
    "@mongodb-js/compass-logging": "^1.18.0",
    "@mongodb-js/compass-telemetry": "^1.34.0",
    "@mongodb-js/compass-workspaces": "^1.4.0",
    "@mongodb-js/connection-info": "^0.29.1",
    "@mongodb-js/mongodb-constants": "^0.34.8",
    "@mongodb-js/search-index-schema": "^2.1.2",
    "@mongodb-js/shell-bson-parser": "^1.5.19",
    "@mongodb-js/workspace-info": "^1.12.0",
    "bson": "^7.3.3",
    "compass-preferences-model": "^3.4.0",
    "json-schema": "^0.4.0",
    "lodash": "^4.18.1",
    "mongodb": "^7.6.0",
    "mongodb-collection-model": "^5.42.1",
    "mongodb-data-service": "^22.41.1",
    "mongodb-ns": "^3.2.0",
    "mongodb-query-parser": "^5.0.5",
    "react": "^18.3.1",
    "react-redux": "^8.1.3",
    "redux": "^4.2.1",
    "redux-thunk": "^2.4.2",
    "semver": "^7.6.3"
  },
  "is_compass_plugin": true
}
